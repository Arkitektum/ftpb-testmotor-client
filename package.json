{
    "name": "@arkitektum/ftpb-testmotor-client",
    "version": "1.2.2",
    "description": "Reads example form data from the FtPB testmotor: which apps it holds, each app's XML files, and its subform files",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "test": "node --test \"src/**/*.test.ts\"",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Arkitektum/ftpb-testmotor-client.git"
    },
    "bugs": {
        "url": "https://github.com/Arkitektum/ftpb-testmotor-client/issues"
    },
    "homepage": "https://github.com/Arkitektum/ftpb-testmotor-client#readme",
    "author": "Arkitektum AS",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@microsoft/eslint-formatter-sarif": "^3.1.0",
        "@types/node": "^26.6.4",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.9",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "yarn@4.15.0"
}
